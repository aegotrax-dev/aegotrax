# Copy to .env (git-ignored) and fill in. The engine, SDK, gateway, demos and
# `docker compose` all read it from the project root.
#
# Use two DIFFERENT secrets. Generate each one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Note: variables already set in your terminal win over .env values, so if a
# window behaves differently from another, check `echo %AEGOTRAX_API_KEY%` (cmd)
# or `$env:AEGOTRAX_API_KEY` (PowerShell) for a stale value.

# Used by the agent / SDK / gateway to call the engine.
AEGOTRAX_API_KEY=

# Used only by humans who approve REQUIRE_APPROVAL calls. Must differ from the API key.
# Several approvers: AEGOTRAX_APPROVER_KEYS=alice:key-a,bob:key-b
AEGOTRAX_APPROVER_KEY=

# enforce (default) | shadow (log what would be blocked, never block)
AEGOTRAX_ENFORCEMENT=enforce
